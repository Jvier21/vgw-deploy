{
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "metadata": {
                "name": "vgw-multitenant-deployment",
                "creationTimestamp": null
        },
        "spec": {
                "replicas": 1,
                "selector": {
                        "matchLabels": {
                                "service": "vgw-multitenant"
                        }
                },
                "template": {
                        "metadata": {
                                "creationTimestamp": null,
                                "labels": {
                                        "service": "vgw-multitenant",
                                        "client": "demo",
                                        "tts_provider": "watson",
                                        "nlp_provider": "watson",
                                        "stt_provider": "watson"
                                }
                        },
                        "spec": {
                                "volumes": [
                                        {
                                                "name": "recordings",
                                                "emptyDir": {}
                                        },
                                        {
                                                "name": "cfgmap",
                                                "configMap": {
                                                        "name": "mrcp-config"
                                                }
                                        }
                                ],
                                "hostNetwork": true,
                                "imagePullSecrets": [
                                        {
                                                "name": "admin.registrykey"
                                        }
                                ],
                                "containers": [
                                        {
                                                "name": "vgw-multitenant-vgw-mr",
                                                "image": "ibmcom/voice-gateway-mr:latest",
                                                "livenessProbe": {
                                                        "exec": {
                                                                "command": [
                                                                        "/bin/sh",
                                                                        "-ec",
                                                                        "cutoffdate=$(date +%u%H); testresult=$(test $cutoffdate -eq 307 && echo 1 || echo 0); exit $testresult"
                                                                ]
                                                        },
                                                        "failureThreshold": 1,
                                                        "initialDelaySeconds": 3600,
                                                        "periodSeconds": 60
                                                },
                                                "ports": [
                                                        {
                                                                "containerPort": 6200,
                                                                "hostPort": 6200,
                                                                "protocol": "TCP"
                                                        },
                                                        {
                                                                "containerPort": 5555,
                                                                "hostPort": 5555,
                                                                "protocol": "TCP"
                                                        },
                                                        {
                                                                "containerPort": 5555,
                                                                "hostPort": 5555,
                                                                "protocol": "UDP"
                                                        }
                                                ],
                                                "lifecycle": {
                                                        "preStop": {
                                                                "exec": {
                                                                        "command": [
                                                                                "/opt/quiesce.sh"
                                                                        ]
                                                                }
                                                        }
                                                },
                                                "env": [
                                                        {
                                                                "name": "SDP_ADDRESS",
                                                                "value": "20.119.178.198"
                                                        },
                                                        {
                                                                "name": "ENABLE_RECORDING",
                                                                "value": "false"
                                                        },
                                                        {
                                                                "name": "RTP_UDP_PORT_RANGE",
                                                                "value": "12000-18394"
                                                        },
                                                        {
                                                                "name": "CLUSTER_WORKERS",
                                                                "value": "0"
                                                        },
                                                        {
                                                                "name": "MEDIA_RELAY_LOG_LEVEL",
                                                                "value": "DEBUG"
                                                        },
                                                        {
                                                                "name": "MEDIA_RELAY_LOG_ROTATION_FILE_COUNT",
                                                                "value": "14"
                                                        },
                                                        {
                                                                "name": "MEDIA_RELAY_WS_PORT",
                                                                "value": "6200"
                                                        },
                                                        {
                                                                "name": "DISABLE_STT_DURING_PLAYBACK",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "STT_TRACK_LATENCY",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "RTCP_MAX_PACKET_LOSS_THRESHOLD",
                                                                "value": "1"
                                                        }
                                                ],
                                                "resources": {},
                                                "volumeMounts": [
                                                        {
                                                                "name": "recordings",
                                                                "mountPath": "/vgw-media-relay/recordings"
                                                        }
                                                ],
                                                "terminationMessagePath": "/dev/termination-log",
                                                "imagePullPolicy": "Always"
                                        },
                                        {
                                                "name": "vgw-multitenant-vgw-so",
                                                "image": "ibmcom/voice-gateway-so:latest",
                                                "livenessProbe": {
                                                        "exec": {
                                                                "command": [
                                                                        "/bin/sh",
                                                                        "-ec",
                                                                        "cutoffdate=$(date +%u%H); testresult=$(test $cutoffdate -eq 307 && echo 1 || echo 0); exit $testresult"
                                                                ]
                                                        },
                                                        "failureThreshold": 1,
                                                        "initialDelaySeconds": 3600,
                                                        "periodSeconds": 60
                                                },
                                                "ports": [
                                                        {
                                                                "containerPort": 30200,
                                                                "hostPort": 30200,
                                                                "protocol": "TCP"
                                                        },
                                                        {
                                                                "containerPort": 30200,
                                                                "hostPort": 30200,
                                                                "protocol": "UDP"
                                                        }
                                                ],
                                                "lifecycle": {
                                                        "preStop": {
                                                                "exec": {
                                                                        "command": [
                                                                                "/opt/quiesce.sh"
                                                                        ]
                                                                }
                                                        }
                                                },
                                                "env": [
                                                        {
                                                                "name": "SIP_HOST",
                                                                "value": "20.119.178.198"
                                                        },
                                                        {
                                                                "name": "MEDIA_RELAY_HOST",
                                                                "value": "localhost:6200"
                                                        },
                                                        {
                                                                "name": "SIP_PORT",
                                                                "value": "30200"
                                                        },
                                                        {
                                                                "name": "SIP_PORT_TCP",
                                                                "value": "30200"
                                                        },
                                                        {
                                                                "name": "ENABLE_AUDIT_MESSAGES",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "ENABLE_TRANSCRIPTION_AUDIT_MESSAGES",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "LOG_LEVEL",
                                                                "value": "all"
                                                        },
                                                        {
                                                                "name": "LOG_MAX_FILES",
                                                                "value": "14"
                                                        },
                                                        {
                                                                "name": "LOG_MAX_FILE_SIZE",
                                                                "value": "500"
                                                        },
                                                        {
                                                                "name": "SEND_SIP_CALL_ID_TO_CONVERSATION",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "SEND_SIP_REQUEST_URI_TO_CONVERSATION",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "SEND_SIP_TO_URI_TO_CONVERSATION",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "SEND_SIP_FROM_URI_TO_CONVERSATION",
                                                                "value": "true"
                                                        },
                                                        {
                                                                "name": "REPORTING_URL",
                                                                "value": "http://vgw-reporting.services.smartia-ai.com/vgw/report"
                                                        },
                                                        {
                                                                "name": "REPORTING_CDR_EVENT_INDEX",
                                                                "value": "cdr"
                                                        },
                                                        {
                                                                "name": "REPORTING_CONVERSATION_EVENT_INDEX",
                                                                "value": "conversation"
                                                        },
                                                        {
                                                                "name": "REPORTING_TRANSCRIPTION_EVENT_INDEX",
                                                                "value": "transcription"
                                                        },
                                                        {
                                                                "name": "MULTI_TENANT_CONFIG_FILE",
                                                                "value": "/mnt/tenantConfiguration.json"
                                                        },
                                                        {
                                                                "name": "CONVERSATION_FAILED_REPLY_MESSAGE",
                                                                "value": "Lo volveremos a llamar. Disculpe las molestias."
                                                        },
                                                        {
                                                                "name": "METRICS_SAMPLING_INTERVAL",
                                                                "value": "1"
                                                        },
                                                        {
                                                                "name": "ENABLE_METRICS_AUTH",
                                                                "value": "false"
                                                        },
                                                        {
                                                                "name": "HTTP_HOST",
                                                                "value": "10.0.0.11"
                                                        },
                                                        {
                                                                "name": "ADMIN_USERNAME",
                                                                "value": "None"
                                                        },
                                                        {
                                                                "name": "ADMIN_PASSWORD",
                                                                "value": "None"
                                                        },
                                                        {
                                                            "name": "POST_RESPONSE_TIMEOUT",
                                                            "value": "70000"
                                                        },
                                                        {
                                                            "name": "SESSION_INACTIVITY_TIMEOUT",
                                                            "value": "10"
                                                        }
                                                ],
                                                "resources": {},
                                                "volumeMounts": [
                                                        {
                                                                "name": "cfgmap",
                                                                "mountPath": "/mnt/tenantConfiguration.json",
                                                                "subPath": "tenantConfiguration.json"
                                                        }
                                                ],
                                                "terminationMessagePath": "/dev/termination-log",
                                                "imagePullPolicy": "Always"
                                        }
                                ],
                                "restartPolicy": "Always",
                                "terminationGracePeriodSeconds": 30,
                                "dnsPolicy": "ClusterFirst",
                                "securityContext": {}
                        }
                }
        },
        "status": {}
}
